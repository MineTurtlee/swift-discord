rd\/discordratelimitkey\/discordratelimiturlparts\/rawvalue","type":"topic","role":"symbol"},"doc://Discord/documentation/Discord/DiscordRateLimitKey":{"type":"topic","abstract":[{"text":"An endpoint is made up of a REST api endpoint and any major parameters in that endpoint.","type":"text"},{"text":" ","type":"text"},{"text":"Ex. \/channels\/232184444340011009\/messages and \/channels\/186926276592795659\/messages","type":"text"},{"text":" ","type":"text"},{"text":"Are considered different endpoints","type":"text"}],"navigatorTitle":[{"text":"DiscordRateLimitKey","kind":"identifier"}],"role":"symbol","title":"DiscordRateLimitKey","identifier":"doc:\/\/Discord\/documentation\/Discord\/DiscordRateLimitKey","url":"\/documentation\/discord\/discordratelimitkey","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DiscordRateLimitKey","kind":"identifier"}]},"doc://Discord/documentation/Discord/DiscordRateLimitKey/DiscordRateLimitURLParts":{"type":"topic","abstract":[{"text":"URL Parts for the purpose of rate limiting.","type":"text"},{"text":" ","type":"text"},{"text":"Combine all the parts of the URL into a list of which parts exist","type":"text"},{"text":" ","type":"text"},{"text":"Ex. \/channels\/232184444340011009\/messages would be represented by [.channels, .channelID, .messages]","type":"text"},{"text":" ","type":"text"},{"text":"Anything that ends in “ID” represents the existence of a snowflake id, but the actual ID should be","type":"text"},{"text":" ","type":"text"},{"text":"stored separately if needed.  Technically, the .guildID and .channelID fields aren’t needed since","type":"text"},{"text":" ","type":"text"},{"text":"the full ID will also be stored, but they’re included to make the system more straightforward.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"DiscordRateLimitURLParts"}],"role":"symbol","title":"DiscordRateLimitKey.DiscordRateLimitURLParts","url":"\/documentation\/discord\/disco