:"symbol","conformance":{"constraints":[{"type":"codeVoice","code":"RawValue"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"FixedWidthInteger"},{"type":"text","text":"."}],"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}]},"type":"topic","identifier":"doc:\/\/Discord\/documentation\/Discord\/DiscordRateLimitKey\/DiscordRateLimitURLParts\/init()","url":"\/documentation\/discord\/discordratelimitkey\/discordratelimiturlparts\/init()","kind":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"()"}],"abstract":[]},"doc://Discord/documentation/Discord/DiscordRateLimitKey":{"url":"\/documentation\/discord\/discordratelimitkey","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DiscordRateLimitKey","kind":"identifier"}],"navigatorTitle":[{"text":"DiscordRateLimitKey","kind":"identifier"}],"type":"topic","kind":"symbol","abstract":[{"type":"text","text":"An endpoint is made up of a REST api endpoint and any major parameters in that endpoint."},{"type":"text","text":" "},{"type":"text","text":"Ex. \/channels\/232184444340011009\/messages and \/channels\/186926276592795659\/messages"},{"type":"text","text":" "},{"type":"text","text":"Are considered different endpoints"}],"role":"symbol","identifier":"doc:\/\/Discord\/documentation\/Discord\/DiscordRateLimitKey","title":"DiscordRateLimitKey"},"doc://Discord/documentation/Discord/DiscordRateLimitKey/DiscordRateLimitURLParts":{"url":"\/documentation\/discord\/discordratelimitkey\/discordratelimiturlparts","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DiscordRateLimitURLParts","kind":"identifier"}],"navigatorTitle":[{"text":"DiscordRateLimitURLParts","kind":"identifier"}],"type":"topic","kind":"symbol","abstract":[{"text":"URL Parts for the purpose of rate limiting.","type":"text"},{"text":" ","type":"text"},{"text":"Combine all the parts of the URL into a list of which parts exist","type":"text"},{"text":" ","type":"text"},{"text":"Ex. \/channels\/232184444340011009\/messages would be represented by [.channels, .channelID, .messages]","type":"text"},{"text":" ","type":"text"},{"text":"Anything that ends in “ID” represents the existence of a snowflake id, but the actual ID should be","type":"text"},{"text":" ","type":"text"},{"text":"stored separately if needed.  Technically, the .guildID and .channelID fields aren’t needed since","type":"text"},{"text":" ","type":"text"},{"text":"the full ID will also be stored, but they’re included to make the system more straightforward.","type":"text"}],"role":"symbol","identifier":"doc:\/\/Discord\/documentation\/Discord\/DiscordRateLimitKey\/DiscordRateLimitURLParts","title":"DiscordRateLimitKey.DiscordRateLimitURLParts"}}}