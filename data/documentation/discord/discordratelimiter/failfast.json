eciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"abstract":[{"type":"text","text":"Whether or not this rate limiter should immediately callback on rate limits."}]},"doc://Discord/documentation/Discord/DiscordRateLimiter":{"role":"symbol","type":"topic","identifier":"doc:\/\/Discord\/documentation\/Discord\/DiscordRateLimiter","url":"\/documentation\/discord\/discordratelimiter","kind":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DiscordRateLimiter","kind":"identifier"}],"abstract":[{"text":"The DiscordRateLimiter is in charge of making sure we don’t flood Discord with requests.","type":"text"},{"text":" ","type":"text"},{"text":"It keeps a dictionary of DiscordRateLimitKeys and DiscordRateLimits.","type":"text"},{"text":" ","type":"text"},{"text":"All requests to the REST api should be routed through the DiscordRateLimiter.","type":"text"},{"text":" ","type":"text"},{"text":"If a DiscordRateLimit determines we have hit a limit, we add the request and its callback to the limit’s queue.","type":"text"},{"text":" ","type":"text"},{"text":"After that it is up to the DiscordRateLimit to decide when to make the request.","type":"text"},{"text":" ","type":"text"},{"text":"TODO handle the global rate limit","type":"text"}],"navigatorTitle":[{"text":"DiscordRateLimiter","kind":"identifier"}],"title":"DiscordRateLimiter"}}}