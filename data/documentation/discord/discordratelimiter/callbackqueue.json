scord/documentation/Discord":{"type":"topic","abstract":[{"text":"Write chat bots using the Discord API.","type":"text"}],"role":"collection","title":"Discord","identifier":"doc:\/\/Discord\/documentation\/Discord","url":"\/documentation\/discord","kind":"symbol"},"doc://Discord/documentation/Discord/DiscordRateLimiter":{"role":"symbol","url":"\/documentation\/discord\/discordratelimiter","abstract":[{"text":"The DiscordRateLimiter is in charge of making sure we don’t flood Discord with requests.","type":"text"},{"text":" ","type":"text"},{"text":"It keeps a dictionary of DiscordRateLimitKeys and DiscordRateLimits.","type":"text"},{"text":" ","type":"text"},{"text":"All requests to the REST api should be routed through the DiscordRateLimiter.","type":"text"},{"text":" ","type":"text"},{"text":"If a DiscordRateLimit determines we have hit a limit, we add the request and its callback to the limit’s queue.","type":"text"},{"text":" ","type":"text"},{"text":"After that it is up to the DiscordRateLimit to decide when to make the request.","type":"text"},{"text":" ","type":"text"},{"text":"TODO handle the global rate limit","type":"text"}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DiscordRateLimiter","kind":"identifier"}],"title":"DiscordRateLimiter","identifier":"doc:\/\/Discord\/documentation\/Discord\/DiscordRateLimiter","navigatorTitle":[{"text":"DiscordRateLimiter","kind":"identifier"}],"kind":"symbol","type":"topic"}}}